# Secrets surfaced by the Deploy-to-Cloudflare flow (and used by `wrangler dev` locally
# when copied to .dev.vars). Both are optional — but set CLAIM_CODE for any worker
# whose URL others might guess before you open it.

# One-time setup code: the first-boot wizard requires it before the wallet can be
# claimed. Without it, whoever opens your worker URL first claims the wallet.
CLAIM_CODE=

# Optional: an OpenRouter API key unlocks non-Workers-AI models (Claude, GLM, ...)
# via the MODEL var. Leave blank to use the free Workers AI model. Can also be
# pasted in the setup wizard instead.
OPENROUTER_API_KEY=
