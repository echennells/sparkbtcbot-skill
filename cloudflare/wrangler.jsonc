{
  "name": "sparkbtcbot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Minify unconditionally: the free plan's 3 MiB gzip cap is only met with
  // minify + the wasm patch + --no-tokens, and Deploy-button builds run plain
  // `wrangler deploy` — the flag must not live only in an npm script.
  "minify": true,
  // Deploy-button deployments land with the workers.dev route disabled unless
  // this is explicit — a new user would get a worker with "No URLs enabled".
  "workers_dev": true,
  // Workers Logs (free tier includes it): without this, "when did X happen"
  // is unanswerable after the fact — no events are retained at all.
  "observability": { "enabled": true },
  // Leaf-vault safety-net snapshot — same 20-min cadence as the Node agent's
  // interval timer (catches timelock refreshes and received transfers).
  "triggers": { "crons": ["*/20 * * * *"] },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "WALLET_DO", "class_name": "WalletDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WalletDO"] }],
  // Spending limits are OPT-IN — add to vars to enable:
  //   "SPARK_MAX_SEND_SATS": "5000"       per-transaction ceiling (sats)
  //   "SPARK_DAILY_BUDGET_SATS": "21000"  rolling 24h cumulative budget
  //   "SPARK_MAX_LN_FEE_SATS": "50"       fixed Lightning fee ceiling
  //                                       (unset = auto: max(25, 0.5% of amount))
  "vars": {
    "SPARK_NETWORK": "MAINNET",
    "MODEL": "z-ai/glm-5.2"
  }
}
