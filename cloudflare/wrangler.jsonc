{
  "name": "sparkbtcbot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Minify unconditionally: the free plan's 3 MiB gzip cap is only met with
  // minify + the wasm patch + --no-tokens, and Deploy-button builds run plain
  // `wrangler deploy` — the flag must not live only in an npm script.
  "minify": true,
  // Leaf-vault safety-net snapshot — same 20-min cadence as the Node agent's
  // interval timer (catches timelock refreshes and received transfers).
  "triggers": { "crons": ["*/20 * * * *"] },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "WALLET_DO", "class_name": "WalletDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WalletDO"] }],
  "vars": {
    "SPARK_NETWORK": "MAINNET",
    "MODEL": "z-ai/glm-5.2",
    "SPARK_MAX_SEND_SATS": "5000",
    "SPARK_MAX_LN_FEE_SATS": "50"
  }
}
